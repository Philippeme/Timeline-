  "businessRules": {
    "statusTransitions": {
      "sequential": {
        "description": "Les étapes doivent être complétées dans l'ordre séquentiel",
        "rule": "Une étape ne peut être complétée que si toutes les étapes précédentes sont complétées"
      },
      "stateTransitions": {
        "NOT_STARTED": {
          "allowedNext": ["IN_PROGRESS", "COMPLETED", "BLOCKED", "CANCELLED"],
          "description": "Une étape non commencée peut passer à n'importe quel autre état"
        },
        "IN_PROGRESS": {
          "allowedNext": ["COMPLETED", "BLOCKED", "CANCELLED"],
          "description": "Une étape en cours peut être complétée, bloquée ou annulée"
        },
        "COMPLETED": {
          "allowedNext": ["IN_PROGRESS", "BLOCKED", "CANCELLED"],
          "description": "Une étape complétée peut être remise en cours, bloquée ou annulée"
        },
        "BLOCKED": {
          "allowedNext": ["IN_PROGRESS", "CANCELLED", "NOT_STARTED"],
          "description": "Une étape bloquée peut être remise en cours, annulée ou remise à zéro"
        },
        "CANCELLED": {
          "allowedNext": ["NOT_STARTED", "IN_PROGRESS"],
          "description": "Une étape annulée peut être remise à zéro ou en cours"
        }
      }
    },
    "cascadeRules": {
      "onCompletion": {
        "description": "Quand une étape est complétée, toutes les étapes suivantes deviennent 'En cours'",
        "action": "SET_SUBSEQUENT_TO_IN_PROGRESS"
      },
      "onBlocked": {
        "description": "Quand une étape est bloquée, toutes les étapes suivantes deviennent 'Bloquées'",
        "action": "SET_SUBSEQUENT_TO_BLOCKED"
      },
      "onCancelled": {
        "description": "Quand une étape est annulée, toutes les étapes suivantes deviennent 'Bloquées'",
        "action": "SET_SUBSEQUENT_TO_BLOCKED"
      },
      "onInProgress": {
        "description": "Quand une étape est en cours, les étapes suivantes non complétées deviennent 'Pas commencé'",
        "action": "SET_SUBSEQUENT_NOT_COMPLETED_TO_NOT_STARTED"
      },
      "onNotStarted": {
        "description": "Quand une étape redevient non commencée, toutes les étapes suivantes deviennent 'Pas commencé'",
        "action": "SET_SUBSEQUENT_TO_NOT_STARTED"
      }
    },
    "timelineVisualization": {
      "lineColors": {
        "COMPLETED": {
          "color": "#4caf50",
          "description": "La ligne après une étape complétée est verte"
        },
        "IN_PROGRESS": {
          "color": "#ff9800",
          "description": "La ligne après une étape en cours est orange"
        },
        "BLOCKED": {
          "color": "#f44336",
          "description": "La ligne après une étape bloquée est rouge"
        },
        "CANCELLED": {
          "color": "#f44336",
          "description": "La ligne après une étape annulée est rouge"
        },
        "NOT_STARTED": {
          "color": "#bdbdbd",
          "description": "La ligne après une étape non commencée est grise"
        }
      },
      "lineRules": {
        "description": "La couleur de la ligne de progression est déterminée par le statut de l'étape précédente",
        "implementation": "La ligne entre deux jalons prend la couleur correspondant au statut de l'étape de gauche"
      }
    }
  },
  
  "apiEndpoints": {
    "processes": {
      "getAll": {
        "method": "GET",
        "endpoint": "/api/processes",
        "description": "Récupère tous les processus"
      },
      "getById": {
        "method": "GET",
        "endpoint": "/api/processes/{id}",
        "description": "Récupère un processus par son ID"
      },
      "getByType": {
        "method": "GET",
        "endpoint": "/api/processes/type/{type}",
        "description": "Récupère tous les processus d'un type donné"
      },
      "create": {
        "method": "POST",
        "endpoint": "/api/processes",
        "description": "Crée un nouveau processus"
      },
      "update": {
        "method": "PUT",
        "endpoint": "/api/processes/{id}",
        "description": "Met à jour un processus existant"
      },
      "delete": {
        "method": "DELETE",
        "endpoint": "/api/processes/{id}",
        "description": "Supprime un processus"
      }
    },
    "steps": {
      "updateStatus": {
        "method": "PATCH",
        "endpoint": "/api/processes/{processId}/steps/{stepId}/status",
        "description": "Met à jour le statut d'une étape",
        "payload": {
          "status": "string",
          "completionDate": "datetime (optional)"
        }
      },
      "getHistory": {
        "method": "GET",
        "endpoint": "/api/processes/{processId}/steps/{stepId}/history",
        "description": "Récupère l'historique des changements d'une étape"
      }
    },
    "statistics": {
      "getOverview": {
        "method": "GET",
        "endpoint": "/api/statistics/overview",
        "description": "Récupère les statistiques générales"
      },
      "getByType": {
        "method": "GET",
        "endpoint": "/api/statistics/type/{type}",
        "description": "Récupère les statistiques pour un type de processus"
      }
    }
  },
  
  "validationRules": {
    "processValidation": {
      "requiredFields": ["type", "declarationNumber", "nina", "steps"],
      "nina": {
        "length": 15,
        "pattern": "^[0-9]{15}$",
        "description": "NINA doit contenir exactement 15 chiffres"
      },
      "declarationNumber": {
        "pattern": "^[NMD]-\\d{4}-\\d{4}$",
        "description": "Numéro de déclaration au format: préfixe-année-numéro"
      }
    },
    "stepValidation": {
      "requiredFields": ["id", "order", "label", "icon", "status"],
      "order": {
        "min": 1,
        "unique": true,
        "description": "L'ordre des étapes doit être unique et commence à 1"
      },
      "status": {
        "allowedValues": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "BLOCKED", "CANCELLED"],
        "description": "Le statut doit être une valeur valide"
      }
    },
    "businessLogicValidation": {
      "sequentialCompletion": {
        "description": "Les étapes doivent être complétées dans l'ordre",
        "rule": "Une étape ne peut être COMPLETED que si toutes les étapes précédentes sont COMPLETED"
      },
      "cascadeConsistency": {
        "description": "Les règles de cascade doivent être respectées",
        "rule": "Si une étape est BLOCKED, toutes les étapes suivantes doivent être BLOCKED"
      }
    }
  },
  
