  "implementations": {
    "statusUpdate": {
      "algorithm": "updateStepStatus",
      "description": "Algorithme pour mettre à jour le statut d'une étape avec application des règles métier",
      "steps": [
        "1. Valider la transition de statut",
        "2. Mettre à jour le statut de l'étape cible",
        "3. Gérer la date de complétion",
        "4. Appliquer les règles de cascade",
        "5. Valider la cohérence du processus",
        "6. Persister les changements",
        "7. Notifier les observateurs"
      ],
      "pseudoCode": "if (isValidTransition(currentStatus, newStatus)) { updateStep(stepId, newStatus); applyCascadeRules(process, stepIndex, newStatus); validateProcess(process); persistChanges(process); notifyObservers(process); }"
    },
    "cascadeLogic": {
      "algorithm": "applyCascadeRules",
      "description": "Logique d'application des règles de cascade aux étapes suivantes",
      "cases": {
        "COMPLETED": "toutes les étapes suivantes deviennent IN_PROGRESS",
        "BLOCKED": "toutes les étapes suivantes deviennent BLOCKED",
        "CANCELLED": "toutes les étapes suivantes deviennent BLOCKED",
        "IN_PROGRESS": "les étapes suivantes non complétées deviennent NOT_STARTED",
        "NOT_STARTED": "toutes les étapes suivantes deviennent NOT_STARTED"
      }
    },
    "visualizationLogic": {
      "algorithm": "calculateTimelineColors",
      "description": "Logique de calcul des couleurs de la timeline selon les statuts",
      "rules": [
        "La couleur d'un jalon dépend de son statut",
        "La couleur d'une ligne dépend du statut de l'étape précédente",
        "Les lignes avant le premier jalon et après le dernier ne sont pas affichées"
      ]
    }
  },
  
